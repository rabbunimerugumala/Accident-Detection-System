# Copy this file to .env and fill in your own Firebase project values
# Get the URL from: Firebase Console → Your Project → Realtime Database → (copy URL)

# Used by the React frontend (Vite)
VITE_FIREBASE_DATABASE_URL=https://<your-project-id>-default-rtdb.firebaseio.com

# Used by Node.js scripts (watchdog.cjs, firebasewriter.cjs)
FIREBASE_DATABASE_URL=https://<your-project-id>-default-rtdb.firebaseio.com
